# ============================================================
# NewsVerify 环境配置模板
# 复制为 .env 后填写密钥，并 chmod 600 .env
# 警告：.env 含密钥，切勿提交到公开仓库
# ============================================================

# --- LLM（OpenAI 兼容接口，主备自动切换）---
# 主 API。容器内访问 NAS 本机服务请用 Docker 网关 172.17.0.1；
# 从 Mac 直连调试时可改为 192.168.8.253。
LLM_BASE_URL=http://172.17.0.1:3065/v1
# 备用 API，主不可用（超时/报错熔断）时自动切换
LLM_BASE_URL_FALLBACK=https://api.caishen.today:8443/v1
LLM_API_KEY=replace-with-your-api-key
# 实测可用模型（避免使用不存在的 auto/deepseek-v4-flash）
LLM_MODEL=gemini-3-flash
LLM_JUDGE_MODEL=gemini-3-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- 联网搜索 ---
# 可选：duckduckgo（默认，无需密钥）/ searxng / brave
SEARCH_PROVIDER=duckduckgo
BRAVE_SEARCH_API_KEY=
GOOGLE_FACTCHECK_API_KEY=
SEARXNG_BASE_URL=
# 合规公开信息采集：逗号分隔的公开 RSS/Atom 源（尊重 robots.txt，不做反爬绕过）
CUSTOM_FEED_URLS=

# --- 多即时通讯接入（统一 webhook：/api/v1/im/{key}/webhook）---
# 每个平台：NV_IM_{KEY}_WEBHOOK 发送地址；NV_IM_{KEY}_SECRET 可选签名密钥
# KEY 取：DISCORD / SLACK / FEISHU / DINGTALK / WECOM / WECHAT_OA / QQ_ONEBOT / LINE / MATRIX / GENERIC
# 例：NV_IM_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
NV_IM_GENERIC_WEBHOOK=
NV_IM_GENERIC_SECRET=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- Public API v1 鉴权（可选）---
API_KEY=

# --- 预算与并发 ---
PER_CHECK_BUDGET_USD=0.10
MONTHLY_BUDGET_USD=1.00
MAX_CLAIMS_PER_CHECK=8
MAX_SEARCH_RESULTS=8
WORKER_CONCURRENCY=2

# --- 数据库（与 compose.yaml 的 POSTGRES_* 保持一致）---
POSTGRES_USER=newsverify
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=newsverify
DATABASE_URL=postgresql+asyncpg://newsverify:change_me_strong@db:5432/newsverify

# --- 运行时 ---
# all=Web+Bot / web / bot / worker（compose.yaml 内会按服务覆盖）
APP_MODE=all
LOG_LEVEL=INFO
TRACKING_DEFAULT_INTERVAL_HOURS=24
TRACKING_FAST_INTERVAL_HOURS=6
TRACKING_WEEKLY_INTERVAL_HOURS=168
DATA_RETENTION_DAYS=90
ENVIRONMENT=production
